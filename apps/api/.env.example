# Local SQLite (path relative to prisma/ schema dir for migrate; Nest resolves absolute)
DATABASE_URL="file:./dev.db"
JWT_SECRET="capstone-dev-jwt-secret-change-in-prod"
CONNECTOR_SECRET="capstone-connector-encrypt-change-in-prod"
PORT=4000
CAPSTONE_CORS_ORIGINS="http://localhost:3000"
WEB_APP_URL="http://localhost:3000"
REDIS_URL="redis://127.0.0.1:6379"
DESK_SCHEDULER_ENABLED=true
AI_ASK_RATE_LIMIT=60

# Account Aggregator TSP (banks/MF/demat — consent redirect when set)
TSP_PROVIDER=simulated
# TSP_PROVIDER=setu
# TSP_API_KEY=
# TSP_BASE_URL=https://api.example-tsp.com/v1
AA_SYNC_ENABLED=true
# AA_SYNC_INTERVAL_MS=21600000

# Upstox OAuth (https://account.upstox.com/developer/apps)
# Redirect URI registered on Upstox must match exactly:
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
# UPSTOX_REDIRECT_URI=http://localhost:4000/connectors/upstox/callback

# Zerodha Kite Connect (https://developers.kite.trade)
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_REDIRECT_URI=http://localhost:4000/connectors/zerodha/callback
