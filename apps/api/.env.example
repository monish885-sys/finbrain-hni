# Local SQLite (path relative to prisma/ schema dir for migrate; Nest resolves absolute)
DATABASE_URL="file:./dev.db"
JWT_SECRET="capstone-dev-jwt-secret-change-in-prod"
CONNECTOR_SECRET="capstone-connector-encrypt-change-in-prod"
PORT=4000
CAPSTONE_CORS_ORIGINS="http://localhost:3000"
WEB_APP_URL="http://localhost:3000"
REDIS_URL="redis://127.0.0.1:6379"
DESK_SCHEDULER_ENABLED=true
AI_ASK_RATE_LIMIT=60

# ── Account Aggregator (Setu) — preferred unified path ──────────────────────
# Bridge: https://bridge.setu.co → create AA Gateway product → API credentials
# Leave TSP_PROVIDER=simulated until keys are filled, then switch to setu.
TSP_PROVIDER=simulated
# TSP_PROVIDER=setu
# SETU_CLIENT_ID=
# SETU_CLIENT_SECRET=
# SETU_PRODUCT_INSTANCE_ID=
# SETU_BASE_URL=https://fiu-sandbox.setu.co
# SETU_TOKEN_URL=https://uat.setu.co/api/v2/auth/token
# SETU_REDIRECT_URL=http://localhost:3000/onboarding/connect/aa-return
# Bridge notification URL (public/ngrok): https://<api-host>/connectors/webhooks/setu

AA_SYNC_ENABLED=true
# AA_SYNC_INTERVAL_MS=21600000

# Optional broker OAuth (not required if using Setu AA)
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
# UPSTOX_REDIRECT_URI=http://localhost:4000/connectors/upstox/callback
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_REDIRECT_URI=http://localhost:4000/connectors/zerodha/callback
